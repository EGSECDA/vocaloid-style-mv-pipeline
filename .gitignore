# vocaloid-style-mv-pipeline — ignore rules for the repo root AND for projects made from
# skills/vocaloid-style-mv/template (patterns are written to match at any depth).
# Everything listed here is either fetched/built by setup, generated by a tool,
# or private (the song itself). Keep code, docs, timelines, palettes and prompts.

# ---------------------------------------------------------------- dependencies
node_modules/
vendor/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
npm-debug.log*
.npm/

# ---------------------------------------------------------------- fetched / built at setup
# Google Fonts binaries (tools/fetch_fonts.py) — the OFL_*.txt licences, fonts.css,
# fonts.js and manifest.json stay tracked
**/engine/fonts/*.ttf
**/engine/fonts/*.otf
**/engine/fonts/*.woff
**/engine/fonts/*.woff2
# JIZURA engine bundle (node tools/build_jizura_bundle.mjs, from vendor/JIZURA)
**/jizura/app/jizura_engine.js
**/jizura/parts.json
**/jizura/probe*/

# ---------------------------------------------------------------- song audio (never commit someone's master)
**/audio/*.wav
**/audio/*.mp3
**/audio/*.flac
**/audio/*.m4a
**/audio/*.aac
**/audio/*.ogg
**/demo/*.wav

# ---------------------------------------------------------------- analysis by-products
**/analysis/stems/
**/analysis/asr/
**/analysis/*.npy
**/analysis/*.npz

# ---------------------------------------------------------------- generated media
render/
**/blender/renders/
_probe/
*.blend1
# tools/imagegen.py keeps the un-keyed green-screen original next to each RGBA asset
**/assets/**/*.raw.png

# videos (the demo clip used by the README is the only exception)
*.mp4
*.mov
*.mkv
!/docs/images/demo*.mp4

# ---------------------------------------------------------------- OS / editors / local agent settings
.DS_Store
._*
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
.claude/settings.local.json
